<view class="page"><view class="toolbar"><picker mode="date" fields="month" value="{{month}}" bindchange="changeMonth"><view>{{month}} ›</view></picker><view class="granularity"><text class="{{granularity === 'day' ? 'active' : ''}}" bindtap="changeGranularity" data-value="day">日</text><text class="{{granularity === 'week' ? 'active' : ''}}" bindtap="changeGranularity" data-value="week">周</text><text class="{{granularity === 'month' ? 'active' : ''}}" bindtap="changeGranularity" data-value="month">月</text></view></view><view class="summary"><view class="card"><text class="muted">收入</text><text class="income">¥{{summary.income}}</text></view><view class="card"><text class="muted">支出</text><text class="expense">¥{{summary.expense}}</text></view><view class="card"><text class="muted">结余</text><text>¥{{summary.balance}}</text></view></view><view class="card"><view class="title">收支趋势</view><view class="trend" wx:for="{{trend}}" wx:key="period"><text>{{item.period}}</text><text class="income">+¥{{item.income}}</text><text class="expense">-¥{{item.expense}}</text></view></view><view class="card"><view class="title">支出分类</view><view class="row" wx:for="{{categories}}" wx:key="category_id"><text>{{item.category}}</text><text>¥{{item.amount}} · {{item.ratio}}%</text></view></view><view class="card"><view class="title">成员支出</view><view class="row" wx:for="{{members}}" wx:key="member"><text>{{item.member}}</text><text>¥{{item.amount}}</text></view></view></view>
