<view class="page"><view class="toolbar"><picker mode="date" fields="month" value="{{month}}" bindchange="changeMonth"><view>{{month}} ▼</view></picker></view><view class="card"><view class="title">收支趋势</view><view class="trend" wx:for="{{trend}}" wx:key="period"><text>{{item.period}}</text><text class="income">+¥{{item.income}}</text><text class="expense">-¥{{item.expense}}</text></view></view><view class="card"><view class="title">支出分类</view><view class="row" wx:for="{{categories}}" wx:key="category_id"><text>{{item.category}}</text><text>¥{{item.amount}} · {{item.ratio}}%</text></view></view><view class="card"><view class="title">成员支出</view><view class="row" wx:for="{{members}}" wx:key="member"><text>{{item.member}}</text><text>¥{{item.amount}}</text></view></view></view>
