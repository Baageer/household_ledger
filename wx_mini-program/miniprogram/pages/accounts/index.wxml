<view class="page"><view class="toolbar"><view class="title">账户管理</view><button wx:if="{{canManage}}" class="small-button" bindtap="openCreate">新增账户</button></view><view wx:if="{{!accounts.length}}" class="card muted">还没有账户，请先新增一个账户</view><view wx:for="{{accounts}}" wx:key="id" class="card account-row"><view><view class="account-name">{{item.name}}</view><view class="muted">{{item.type}} · {{item.currency}} · {{item.owner_id ? '个人账户' : '家庭公共账户'}}</view></view><view class="account-right"><view class="balance">¥{{item.initial_balance}}</view><view class="status {{item.status === 'disabled' ? 'off' : ''}}">{{item.status === 'active' ? '正常' : '已停用'}}</view><view wx:if="{{canManage && item.status === 'active'}}" class="actions"><text bindtap="edit" data-item="{{item}}">编辑</text><text class="danger" bindtap="disable" data-item="{{item}}">停用</text></view></view></view><view wx:if="{{showForm}}" class="form-card card"><view class="form-title">{{editingId ? '编辑账户' : '新增账户'}}</view><input class="input" placeholder="账户名称" value="{{form.name}}" bindinput="input" data-key="name" /><view class="field"><text>账户类型</text><picker range="{{types}}" range-key="name" bindchange="pickType"><view>{{form.type}} ›</view></picker></view><view class="field"><text>归属成员</text><picker range="{{members}}" range-key="nickname" bindchange="pickOwner"><view>{{ownerName}} ›</view></picker></view><input class="input" type="digit" placeholder="初始余额" value="{{form.initial_balance}}" bindinput="input" data-key="initial_balance" /><view class="form-actions"><button bindtap="closeForm">取消</button><button class="primary-button" loading="{{saving}}" bindtap="save">保存</button></view></view></view>
