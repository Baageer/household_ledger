.toolbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:24rpx; }.small-button { margin:0; padding:0 24rpx; height:68rpx; line-height:68rpx; font-size:26rpx; color:#2563eb; background:#eaf1ff; }.account-row { display:flex; justify-content:space-between; align-items:center; }.account-name { font-size:32rpx; font-weight:600; margin-bottom:8rpx; }.account-right { text-align:right; }.balance { font-size:30rpx; font-weight:600; }.status { color:#16a34a; font-size:24rpx; margin-top:6rpx; }.status.off { color:#8a919f; }.actions { display:flex; gap:24rpx; margin-top:12rpx; color:#2563eb; font-size:24rpx; }.form-card { margin-top:28rpx; }.form-title { font-size:32rpx; font-weight:600; margin-bottom:16rpx; }.input { padding:20rpx 0; border-bottom:1rpx solid #eef0f4; margin-bottom:8rpx; }.field { display:flex; justify-content:space-between; align-items:center; padding:24rpx 0; border-bottom:1rpx solid #eef0f4; }.field picker { color:#2563eb; }.form-actions { display:flex; gap:20rpx; margin-top:24rpx; }.form-actions button { flex:1; margin:0; }.form-actions .primary-button { color:#fff; }
