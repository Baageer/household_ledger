<view class="page"><view class="card"><view class="title">导入审核</view><view class="muted">{{task.file_name}} · {{task.status}}</view><view class="summary">共 {{task.total_count}} 条，成功 {{task.success_count}}，重复 {{task.duplicate_count}}，错误 {{task.error_count}}</view></view><view wx:for="{{rows}}" wx:key="id" class="card row"><view class="row-main"><view>{{item.merchant}} · ¥{{item.amount}}</view><view class="muted">{{item.transaction_time}} · {{item.direction}}</view><view wx:if="{{item.error_reason}}" class="danger">{{item.error_reason}}</view></view><view class="row-actions"><text bindtap="edit" data-row="{{item}}">编辑</text></view></view><button wx:if="{{task.status === 'failed'}}" bindtap="retry">重新解析</button><button wx:if="{{task.status === 'reviewing'}}" class="primary-button" loading="{{confirming}}" bindtap="confirm">确认全部入账</button></view>
