<view class="page"><view class="title">导入账单</view><view class="card"><view class="field"><text>账单来源</text><picker range="{{sources}}" range-key="name" bindchange="pickSource"><view>{{source}} ›</view></picker></view><view class="field"><text>入账账户</text><picker range="{{accounts}}" range-key="name" bindchange="pickAccount"><view>{{accountName || '请选择账户'}} ›</view></picker></view><view class="file-picker" bindtap="chooseFile">{{file ? file.name : '选择 CSV / Excel 文件'}}</view><view class="muted hint">仅支持支付宝或微信账单文件，单文件不超过 20MB</view></view><button class="primary-button" loading="{{uploading}}" bindtap="upload">上传并解析</button></view>
