<view class="page"><view class="toolbar"><view class="title">预算管理</view><button class="small-button" bindtap="add">新增预算</button></view><view wx:if="{{!budgets.length}}" class="muted">暂无预算数据</view><view wx:for="{{budgets}}" wx:key="id" class="card"><view class="row"><text>{{item.category}}</text><text>¥{{item.used}} / ¥{{item.budget}}</text></view><progress percent="{{item.usage_ratio * 100}}" activeColor="{{item.over_budget ? '#dc2626' : '#2563eb'}}"/><view class="muted">{{item.over_budget ? '已超预算' : '剩余 ¥' + item.remaining}}</view><view class="actions"><button size="mini" data-index="{{index}}" bindtap="edit">编辑</button><button size="mini" data-index="{{index}}" bindtap="remove">删除</button></view></view></view>
