<view class="page"><view class="card"><view class="types"><view wx:for="{{types}}" wx:key="key" class="type {{form.type === item.key ? 'active' : ''}}" bindtap="setType" data-type="{{item.key}}">{{item.name}}</view></view><input class="amount-input" type="digit" placeholder="0.00" value="{{form.amount}}" bindinput="input" data-key="amount"/><view class="field"><text>账户</text><picker range="{{accounts}}" range-key="name" bindchange="pickAccount"><view>{{accountName || '请选择账户'}} ›</view></picker></view><view wx:if="{{form.type === 'transfer'}}" class="field"><text>转入账户</text><picker range="{{accounts}}" range-key="name" bindchange="pickTarget"><view>{{targetName || '请选择转入账户'}} ›</view></picker></view><view wx:if="{{form.type !== 'transfer'}}" class="field"><text>分类 ID</text><input placeholder="可选，后续由分类选择器替换" value="{{form.category_id}}" bindinput="input" data-key="category_id"/></view><view class="field"><text>商户</text><input placeholder="如：美团外卖" value="{{form.merchant}}" bindinput="input" data-key="merchant"/></view><view class="field"><text>备注</text><input placeholder="选填" value="{{form.description}}" bindinput="input" data-key="description"/></view></view><button class="primary-button" loading="{{saving}}" bindtap="save">保存</button></view>
