<view class="page"><view wx:if="{{item}}" class="card"><view class="title">{{item.type === 'expense' ? '支出' : item.type === 'income' ? '收入' : '转账'}}</view><view class="amount">¥{{item.amount}}</view><view class="row"><text>商户</text><text>{{item.merchant || '未填写'}}</text></view><view class="row"><text>备注</text><text>{{item.description || '无'}}</text></view><view class="row"><text>时间</text><text>{{item.transaction_time}}</text></view></view><button wx:if="{{item}}" class="danger-button" bindtap="remove">删除账单</button></view>
