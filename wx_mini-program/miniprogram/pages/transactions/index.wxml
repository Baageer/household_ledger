<view class="page"><view class="toolbar"><picker mode="date" fields="month" value="{{month}}" bindchange="changeMonth"><view class="month">{{month}} ▼</view></picker><text class="muted">共 {{total}} 笔</text></view><view wx:for="{{groups}}" wx:key="date" class="card"><view class="date-title">{{item.date}}</view><transaction-item wx:for="{{item.items}}" wx:key="id" item="{{item}}" bind:select="select"/></view><view wx:if="{{!groups.length}}" class="muted empty">暂无账单</view><view wx:if="{{loading}}" class="muted loading">加载中...</view></view>
