<view class="page"><view class="header"><view class="title">本月家庭收支</view><view class="muted">{{month}}</view></view><state-view wx:if="{{state !== 'ready'}}" state="{{state}}" bind:action="load"/><view wx:if="{{state === 'ready'}}"><view class="card amounts"><amount-card label="收入" value="{{summary.income}}" tone="income"/><amount-card label="支出" value="{{summary.expense}}" tone="expense"/><amount-card label="结余" value="{{summary.balance}}"/></view><view class="card"><view class="section-title">支出排行</view><view wx:for="{{categoryRanking}}" wx:key="category_id" class="rank"><text>{{item.category}}</text><text class="expense">¥{{item.amount}}</text></view><view wx:if="{{!categoryRanking.length}}" class="muted empty">暂无支出</view></view><view class="card"><view class="section-title">预算使用</view><view wx:for="{{budgets}}" wx:key="id" class="budget"><view class="row"><text>{{item.category}}</text><text>{{item.usage_ratio}}%</text></view><progress percent="{{item.usage_percent}}" activeColor="{{item.over_budget ? '#dc2626' : '#2563eb'}}" stroke-width="8"/></view></view><button class="quick primary-button" bindtap="add">＋ 记一笔</button></view></view>
