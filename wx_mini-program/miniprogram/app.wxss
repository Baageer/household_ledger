page { background: #f7f8fa; color: #172033; font-size: 28rpx; }
.page { min-height: 100vh; box-sizing: border-box; padding: 32rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 6rpx 24rpx rgba(23, 32, 51, .04); }
.title { font-size: 36rpx; font-weight: 700; }
.muted { color: #8a919f; }
.primary-button { background: #2563eb; color: #fff; border-radius: 12rpx; }
.danger { color: #dc2626; }
.income { color: #16a34a; }
.expense { color: #dc2626; }
