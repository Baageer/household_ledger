.transaction-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #eef0f4; }
.icon { width: 64rpx; height: 64rpx; line-height: 64rpx; border-radius: 50%; background: #eff6ff; color: #2563eb; text-align: center; }
.main { flex: 1; margin-left: 20rpx; line-height: 1.7; }.muted { color: #8a919f; font-size: 24rpx; }.amount { font-weight: 600; }.income { color: #16a34a; }.expense { color: #dc2626; }
